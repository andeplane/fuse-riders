{
  "name": "fuse-riders",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm build && tsx service/dev.ts --port ${PORT:-8787}",
    "build": "tsc --noEmit && vite build",
    "prestart": "pnpm build",
    "start": "pnpm build && tsx service/dev.ts --port ${PORT:-8787}",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test ${TEST_SHARD:+--test-shard=$TEST_SHARD} tests/*.test.ts packages/*/tests/*.test.ts games/*/tests/*.test.ts",
    "test:coverage": "c8 tsx --test tests/*.test.ts packages/*/tests/*.test.ts games/*/tests/*.test.ts",
    "dev:online": "pnpm build && tsx service/dev.ts --port 8787",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "config:check": "tsx scripts/deploy-configuration.ts --check",
    "config:plan": "tsx scripts/deploy-configuration.ts --plan"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.1.0",
    "@google-cloud/pubsub": "^6.0.1",
    "@stdlib/math-base-special-atan2": "0.3.1",
    "@stdlib/math-base-special-cos": "0.3.1",
    "@stdlib/math-base-special-sin": "0.3.1",
    "dice": "workspace:*",
    "fuse-drivers": "workspace:*",
    "fuse-network-be": "workspace:*",
    "fuse-platform": "workspace:*",
    "fuse-riders-game": "workspace:*",
    "jose": "^6.2.12",
    "tsx": "^4.20.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@msgpack/msgpack": "3.1.3",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "c8": "^12.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "firebase": "^12.19.0",
    "fuse-netcode": "workspace:*",
    "fuse-network-fe": "workspace:*",
    "fuse-network-protocol": "workspace:*",
    "fuse-ui": "workspace:*",
    "google-auth-library": "^11.0.2",
    "linkedom": "^0.18.13",
    "mixpanel-browser": "^2.83.0",
    "phaser": "4.2.1",
    "playwright": "^1.55.0",
    "prettier": "3.9.7",
    "qrcode": "^1.5.4",
    "source-map-js": "1.2.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.70.0",
    "vite": "^7.1.5",
    "yaml": "^2.9.1"
  }
}

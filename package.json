{
  "name": "fuse-riders",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --exclude '**/.vite-temp/**' src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "prestart": "npm run build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "test:coverage": "c8 tsx --test tests/*.test.ts",
    "dev:online": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "typecheck:worker": "tsc -p worker/tsconfig.json"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@google-cloud/firestore": "^9.1.0",
    "@google-cloud/pubsub": "^6.0.1",
    "phaser": "3.90.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "c8": "^12.0.0",
    "google-auth-library": "^11.0.2",
    "playwright": "^1.55.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.131.1"
  }
}

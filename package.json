{
  "name": "fuse-riders",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --exclude '**/.vite-temp/**' src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "prestart": "npm run build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts packages/*/tests/*.test.ts",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "test:coverage": "c8 tsx --test tests/*.test.ts packages/*/tests/*.test.ts",
    "dev:online": "npm run build && tsx src/service/dev.ts --port 8787",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@google-cloud/firestore": "^9.1.0",
    "@google-cloud/pubsub": "^6.0.1",
    "@msgpack/msgpack": "3.1.3",
    "@stdlib/math-base-special-atan2": "0.3.1",
    "@stdlib/math-base-special-cos": "0.3.1",
    "@stdlib/math-base-special-sin": "0.3.1",
    "fuse-network-be": "0.1.0",
    "fuse-network-fe": "0.1.0",
    "mixpanel-browser": "^2.83.0",
    "phaser": "3.90.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3",
    "firebase": "^12.19.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "c8": "^12.0.0",
    "google-auth-library": "^11.0.2",
    "playwright": "^1.55.0",
    "prettier": "3.9.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "workspaces": [
    "packages/*"
  ]
}

{
  "name": "fuse-riders",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && tsx src/service/dev.ts --port ${PORT:-8787}",
    "build": "tsc --noEmit && vite build",
    "prestart": "npm run build",
    "start": "npm run build && tsx src/service/dev.ts --port ${PORT:-8787}",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts packages/*/tests/*.test.ts",
    "test:coverage": "c8 tsx --test tests/*.test.ts packages/*/tests/*.test.ts",
    "dev:online": "npm run build && tsx src/service/dev.ts --port 8787",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "config:check": "tsx scripts/deploy-configuration.ts --check",
    "config:plan": "tsx scripts/deploy-configuration.ts --plan"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.1.0",
    "@google-cloud/pubsub": "^6.0.1",
    "@stdlib/math-base-special-atan2": "0.3.1",
    "@stdlib/math-base-special-cos": "0.3.1",
    "@stdlib/math-base-special-sin": "0.3.1",
    "fuse-network-be": "0.1.0",
    "ws": "^8.18.3",
    "jose": "^6.2.12",
    "tsx": "^4.20.5",
    "fuse-platform": "0.1.0"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@msgpack/msgpack": "3.1.3",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "c8": "^12.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "firebase": "^12.19.0",
    "fuse-netcode": "0.1.0",
    "fuse-network-fe": "0.1.0",
    "fuse-ui": "0.1.0",
    "google-auth-library": "^11.0.2",
    "linkedom": "^0.18.13",
    "mixpanel-browser": "^2.83.0",
    "phaser": "4.2.1",
    "playwright": "^1.55.0",
    "prettier": "3.9.7",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.70.0",
    "vite": "^7.1.5"
  },
  "workspaces": [
    "packages/*"
  ]
}

{
  "name": "fuse-riders",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm build && tsx service/dev.ts --port ${PORT:-8787}",
    "build": "tsc --noEmit && tsc --noEmit -p packages/fuseos && vite build",
    "prestart": "pnpm build",
    "start": "pnpm build && tsx service/dev.ts --port ${PORT:-8787}",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/fuseos",
    "test": "tsx scripts/run-tests.ts",
    "test:coverage": "tsx scripts/test-coverage.ts",
    "test:os": "vitest run --root packages/fuseos",
    "test:os:coverage": "vitest run --root packages/fuseos --coverage",
    "fuseos:sync": "node scripts/fuseos/copy-jsdos.mjs && node scripts/fuseos/copy-clippy.mjs",
    "dev:online": "pnpm build && tsx service/dev.ts --port 8787",
    "gallery:capture": "tsx scripts/gallery-capture.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "config:check": "tsx scripts/deploy-configuration.ts --check",
    "config:plan": "tsx scripts/deploy-configuration.ts --plan"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.1.0",
    "@google-cloud/pubsub": "^6.0.1",
    "@stdlib/math-base-special-atan2": "0.3.1",
    "@stdlib/math-base-special-cos": "0.3.1",
    "@stdlib/math-base-special-sin": "0.3.1",
    "ball-bros": "workspace:*",
    "dice": "workspace:*",
    "elasto-fuse": "workspace:*",
    "fuse-axe": "workspace:*",
    "fuse-birds-game": "workspace:*",
    "fuse-bombers": "workspace:*",
    "fuse-choppers": "workspace:*",
    "fuse-craft": "workspace:*",
    "fuse-drivers": "workspace:*",
    "fuse-freight": "workspace:*",
    "fuse-front": "workspace:*",
    "fuse-lane": "workspace:*",
    "fuse-network-be": "workspace:*",
    "fuse-platform": "workspace:*",
    "fuse-riders-game": "workspace:*",
    "fuse-volley": "workspace:*",
    "fuseball": "workspace:*",
    "graveyard-shift": "workspace:*",
    "hook-havok": "workspace:*",
    "jose": "^6.2.12",
    "killer-fuse": "workspace:*",
    "tsx": "^4.20.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@msgpack/msgpack": "3.1.3",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "c8": "^12.0.0",
    "clippyjs": "^0.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "fake-indexeddb": "^6.2.8",
    "firebase": "^12.19.0",
    "fuse-netcode": "workspace:*",
    "fuse-network-fe": "workspace:*",
    "fuse-network-protocol": "workspace:*",
    "fuse-ui": "workspace:*",
    "google-auth-library": "^11.0.2",
    "happy-dom": "^21.0.4",
    "js-dos": "8.4.1",
    "linkedom": "^0.18.13",
    "mixpanel-browser": "^2.83.0",
    "phaser": "4.2.1",
    "playwright": "^1.55.0",
    "prettier": "3.9.7",
    "qrcode": "^1.5.4",
    "source-map-js": "1.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.70.0",
    "vite": "^7.1.5",
    "vitest": "4.1.12",
    "yaml": "^2.9.1"
  }
}

{
  "name": "fuse-riders",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-13",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "SignalRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalRoom"] }],
  "observability": { "enabled": false }
}

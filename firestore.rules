rules_version = '2';

// Browsers never talk to Firestore. Every read and write goes through the Cloud Run gateway,
// which authenticates with IAM (roles/datastore.user) and bypasses these rules entirely.
// The Firebase web API key is public by design, so anything allowed here is allowed to the
// whole internet: keep this file deny-all. See README.md "Firebase".
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

{
  "name": "fuseos",
  "version": "0.1.0",
  "private": true,
  "description": "FuseOS: the Windows 95 desktop that fronts the Fuse games, served at the site root in place of the old gallery.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./src/main.tsx"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "98.css": "^0.1.21",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@mlc-ai/web-llm": "^0.2.88",
    "@react95/icons": "^2.12.0",
    "fuse-ui": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-rnd": "^10.5.3",
    "three": "0.186.1",
    "webamp": "2.3.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0"
  }
}

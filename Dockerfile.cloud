# TypeScript stays server-side; tsx is an explicit, lockfile-pinned runtime dependency.
FROM node:22-bookworm-slim
ARG BUILD_REVISION=unknown
LABEL org.opencontainers.image.title="Fuse Riders room gateway" \
      org.opencontainers.image.revision=$BUILD_REVISION
WORKDIR /app
COPY package.json package-lock.json ./
# The workspace manifests must be present for npm ci to link fuse-network-be and its protocol package.
COPY packages/fuse-network-protocol/package.json ./packages/fuse-network-protocol/
COPY packages/fuse-network-fe/package.json ./packages/fuse-network-fe/
COPY packages/fuse-network-be/package.json ./packages/fuse-network-be/
RUN npm ci --include=dev --no-audit --no-fund && npm cache clean --force
COPY --chown=node:node src ./src
COPY --chown=node:node packages ./packages
# The running service reports this on /api/health; the Pages release publishes only the revision the backend serves.
ENV NODE_ENV=production PORT=8080 BUILD_REVISION=$BUILD_REVISION
USER node
EXPOSE 8080
CMD ["node", "--import", "tsx", "src/service/index.ts"]

# Production dependencies only. TypeScript runs through tsx, which is therefore a lockfile-pinned
# runtime dependency; everything only the browser bundle, the tests or the tooling need is a
# devDependency and stays out of the image. tests/service-image-dependencies.test.ts checks that
# nothing the entrypoint imports is dev-only.
FROM node:22-bookworm-slim
ARG BUILD_REVISION=unknown
LABEL org.opencontainers.image.title="Fuse Riders room gateway" \
      org.opencontainers.image.revision=$BUILD_REVISION
WORKDIR /app
# Corepack installs the pnpm version package.json pins in `packageManager`.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable pnpm
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# The workspace manifests must be present for pnpm to link fuse-network-be and its protocol package.
COPY packages/fuse-network-protocol/package.json ./packages/fuse-network-protocol/
COPY packages/fuse-network-fe/package.json ./packages/fuse-network-fe/
COPY packages/fuse-network-be/package.json ./packages/fuse-network-be/
# node_modules hardlinks into the store, so removing the store afterwards keeps the installed files.
RUN pnpm install --prod --frozen-lockfile && rm -rf "$(pnpm store path)"
COPY --chown=node:node src ./src
COPY --chown=node:node packages ./packages
# The running service reports this on /api/health; the Pages release publishes only the revision the backend serves.
ENV NODE_ENV=production PORT=8080 BUILD_REVISION=$BUILD_REVISION
USER node
EXPOSE 8080
CMD ["node", "--import", "tsx", "src/service/index.ts"]

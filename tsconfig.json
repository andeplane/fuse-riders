{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "include": [
    "service",
    "site",
    "dev",
    "tests",
    "scripts",
    "packages",
    "games",
    "vite.config.ts"
  ],
  // FuseOS (React, vitest globals, jest-dom) has its own program: packages/fuseos/tsconfig.json. Its app source
  // still enters this one through site/main.ts, which is why `jsx` is set; its tests do not.
  "exclude": ["packages/fuseos"]
}

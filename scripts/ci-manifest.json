{
  "about": "Every CI step, once. .github/workflows/ci.yml builds its browser matrix from `smokes` (one job per entry) and scripts/ci-local.sh runs `verify`, `release` and then `smokes`, all through scripts/ci-run.ts. A verify step's `job` is the ci.yml job that runs it: they run side by side and `verify` is the aggregate a branch rule waits on. `release` is what only a main push and the release suite run. Those jobs' steps are written out in ci.yml so they keep their names there; tests/ci-manifest.test.ts fails when the lists differ. Fields are documented in scripts/lib/ci-manifest.ts.",
  "verify": [
    { "id": "format", "command": "pnpm format:check", "job": "checks" },
    { "id": "lint", "command": "pnpm lint", "job": "checks" },
    { "id": "config", "command": "pnpm config:check", "job": "checks" },
    { "id": "build", "command": "pnpm build", "job": "checks" },
    { "id": "unit", "command": "pnpm test", "job": "unit" }
  ],
  "release": [
    {
      "id": "coverage-browser-install",
      "command": "pnpm exec playwright install --with-deps chromium"
    },
    { "id": "coverage", "command": "pnpm test:coverage" }
  ],
  "smokes": [
    {
      "id": "birds-replay",
      "group": "birds-replay",
      "name": "Fuse Birds deterministic browser replay",
      "command": "pnpm exec tsx scripts/fuse-birds-replay-check.ts",
      "browsers": ["chromium", "firefox", "webkit"],
      "env": {},
      "timeoutMinutes": 15,
      "retries": 0
    },
    {
      "id": "keyboard",
      "group": "keyboard",
      "name": "Desktop keyboard steering and firing",
      "command": "pnpm exec tsx scripts/keyboard-smoke.ts",
      "browsers": ["chromium", "webkit"],
      "env": {},
      "serviceUrlEnv": "HOME_URL",
      "timeoutMinutes": 20,
      "retries": 1
    },
    {
      "id": "desktop",
      "group": "desktop",
      "name": "Desktop control bar and keyboard help",
      "why": "Compact desktop bar, ultrawide fit, resize recovery and the ? help: uncovered until #166 found it broken.",
      "command": "pnpm exec tsx scripts/desktop-controls-smoke.ts",
      "browsers": ["chrome"],
      "env": {},
      "serviceUrlEnv": "ONLINE_URL",
      "timeoutMinutes": 20,
      "retries": 1
    },
    {
      "id": "online-chrome",
      "group": "online",
      "name": "Online WebRTC room smoke (Phaser Canvas)",
      "why": "Keep five-peer functional assertions on Phaser Canvas; six software-GL views overloaded the runner. Single-view Phaser remains a separate required gate.",
      "command": "pnpm exec tsx scripts/online-smoke.ts",
      "browsers": ["chromium"],
      "env": { "ROOM_RENDERER": "phaser-canvas" },
      "serviceUrlEnv": "ONLINE_URL",
      "timeoutMinutes": 25,
      "retries": 1
    },
    {
      "id": "online-webkit",
      "group": "online",
      "name": "Online WebKit room smoke (Phaser Canvas)",
      "command": "pnpm exec tsx scripts/online-smoke.ts",
      "browsers": ["webkit"],
      "env": {
        "SMOKE_RIDERS": "3",
        "BROWSER": "webkit",
        "ROOM_RENDERER": "phaser-canvas"
      },
      "serviceUrlEnv": "ONLINE_URL",
      "timeoutMinutes": 25,
      "retries": 1
    },
    {
      "id": "ready-check",
      "group": "online",
      "name": "Phone readiness starts and rematches without the TV",
      "command": "pnpm exec tsx scripts/ready-check-smoke.ts",
      "browsers": ["chromium"],
      "env": {},
      "serviceUrlEnv": "ONLINE_URL",
      "timeoutMinutes": 10,
      "retries": 1
    },
    {
      "id": "voice",
      "group": "voice",
      "name": "Online voice chat (synthetic microphone)",
      "why": "Chromium's synthetic microphone sends real RTP over the mesh. Browser emulation: not physical-phone, Bluetooth, acoustic echo or Safari evidence.",
      "command": "pnpm exec tsx scripts/voice-smoke.ts",
      "browsers": ["chromium"],
      "env": {},
      "serviceUrlEnv": "ONLINE_URL",
      "timeoutMinutes": 20,
      "retries": 1
    },
    {
      "id": "preview-chrome",
      "group": "preview",
